# ─── DATABASE ─────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nigris

# ─── REDIS ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AUTH ─────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
SESSION_SECRET=CHANGE_ME_generate_a_64_char_random_string

# ─── SMTP / MAIL ──────────────────────────────
SMTP_ENCRYPTION_KEY=CHANGE_ME_32_byte_hex_string

# ─── RESEND (transactional email) ─────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# IMPORTANT: To send to ANY recipient (not just your own email),
# verify a domain at https://resend.com/domains and use it here.
# Without a verified domain, Resend's free tier only allows sending
# to the email address tied to your Resend account.
EMAIL_FROM=Nigris <noreply@yourdomain.com>
# Set this to skip email verification entirely (useful if no email service):
# SKIP_EMAIL_VERIFICATION=true

# ─── STRIPE (optional) ───────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── RAZORPAY (optional) ─────────────────────
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# ─── CLIENT ───────────────────────────────────
CLIENT_URL=http://localhost:3000
NODE_ENV=development
PORT=8000
